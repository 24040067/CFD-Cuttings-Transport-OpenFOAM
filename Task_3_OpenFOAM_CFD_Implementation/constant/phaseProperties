FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type twoPhaseEulerFoam;

phases (water particles);

water
{
    transportModel  HerschelBulkley;
    HerschelBulkleyCoeffs
    {
        nu0         1e-03;
        tau0        0.005;
        k           0.04;
        n           0.7;
    }
    thermodynamicProperties
    {
        rho         1000;
    }
}

particles
{
    transportModel  kineticTheory;
    kineticTheoryCoeffs
    {
        equilibrium             off;
        e                       0.9;
        alphaMax                0.62;
        alphaMinFriction        0.55;
        frictionAngle           28.5;
        
        viscosityModel          Gidaspow;
        conductivityModel       Gidaspow;
        granularPressureModel   Lun;
        frictionalStressModel   JohnsonJackson;
        radialModel             SinclairJackson;
    }
    thermodynamicProperties
    {
        rho         2650;
    }
    diameterModel   constant;
    constantCoeffs
    {
        d           0.003;
    }
}

drag
(
    (particles in water)
    {
        type        WenYu;
    }
);
